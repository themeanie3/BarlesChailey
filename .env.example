# Copy to .env for local `npx expo start`. In EAS these live in the
# development / preview / production environments (eas env:create).
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_NEON_AUTH_URL=https://ep-floral-night-aujf5smv.neonauth.c-10.us-east-1.aws.neon.tech/neondb/auth
# Google OAuth client IDs from your own Google Cloud project (see docs/SETUP.md).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client id, e.g. com.googleusercontent.apps.1234567890-abc
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Set to 1 only for builds signed with a profile that carries the Apple Critical Alerts entitlement.
EXPO_PUBLIC_CRITICAL_ALERTS=0
# From `eas init`
EAS_PROJECT_ID=
EXPO_ACCOUNT_OWNER=
