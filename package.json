{
  "name": "barleschailey",
  "version": "1.0.0",
  "private": true,
  "description": "Off-duty firefighter/paramedic dispatch alerting for Montgomery County, MD (Rockville VFD)",
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci --passWithNoTests",
    "feed:typecheck": "npm run typecheck -w @barleschailey/feed",
    "api:typecheck": "npm run typecheck -w @barleschailey/api",
    "api:test": "npm run test -w @barleschailey/api",
    "api:dev": "npm run dev -w @barleschailey/api",
    "check": "npm run feed:typecheck && npm run api:typecheck && npm run api:test && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@better-auth/expo": "^1.4.22",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "^1.4.22",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-maps": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "react": "19.2.3"
  }
}
